# Copy to .env and fill in. Never commit .env.

# Brain server
DATABASE_URL=postgres://kovan:kovan@localhost:5433/kovan
SERVER_PORT=4807
PUBLIC_URL=http://localhost:4807
# App-side encryption of transcripts and GitHub tokens: "id:base64key" pairs (32 random bytes
# each), comma separated; the highest id encrypts. Generate one with:
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
# Without it the server makes a throwaway key, and stored transcripts can't be read after a restart.
ENCRYPTION_KEYS=

# Auth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=

# Models
OPENROUTER_API_KEY=

# Billing (phase 11)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Hardening and deployment (phase 12)
# true only behind a reverse proxy (deploy/ sets it): the caller's address comes from X-Forwarded-For.
TRUST_PROXY=
# API calls per signed-in person per minute.
API_RATE_LIMIT=600
SECURITY_CONTACT=kovan@alperkayan.dev
# Webhook targets allowed although private or plain http: exact host:port, comma separated
# (e.g. founderos:4100). Every other webhook must be public https.
KOVAN_WEBHOOK_ALLOW=
# The built website to serve (apps/web/dist); empty serves none.
WEB_DIR=
# Where installers and update manifests are published; /download/* and /updates/* redirect there.
DOWNLOAD_BASE_URL=
