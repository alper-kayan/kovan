{
  "name": "@kovan/cli",
  "version": "0.4.4",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "kovan: Kovan's coding agent in the terminal. The same agent loop as the desktop app and agentd, with a prompt in front of it.",
  "bin": {
    "kovan": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "bundle": "node scripts/bundle.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@kovan/harness": "workspace:*",
    "@kovan/model-gateway": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
