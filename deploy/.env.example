# Copy to deploy/.env (never commit it) and fill in.
KOVAN_DOMAIN=kovan.example.com
KOVAN_IMAGE=kovan-server:latest

# Managed Postgres, TLS required.
DATABASE_URL=postgres://user:password@host:5432/kovan?sslmode=require
# "id:base64key" pairs, highest id encrypts:
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Kovan <hello@kovan.example.com>

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Managed usage (optional): both or neither.
MANAGED_OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where installers and update manifests are published, e.g.
# https://github.com/<org>/<repo>/releases/latest/download
DOWNLOAD_BASE_URL=
SECURITY_CONTACT=security@kovan.example.com
# Webhook targets allowed although private or plain http: exact host:port, comma separated
# (e.g. founderos:4100). Every other webhook must be public https.
KOVAN_WEBHOOK_ALLOW=

# Backups
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=2
BACKUP_DIR=./backups
