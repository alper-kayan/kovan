{
  "name": "@kovan/server",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "build:monitor": "esbuild src/monitor/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/monitor.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^9.3.0",
    "@fastify/websocket": "^11.3.4",
    "@kovan/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "nodemailer": "^10.1.0",
    "postgres": "^3.4.9",
    "ws": "^8.22.0",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15"
  }
}
